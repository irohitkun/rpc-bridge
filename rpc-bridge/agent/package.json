{
  "name": "rpc-bridge-agent",
  "version": "1.0.0",
  "description": "Universal Discord Rich Presence bridge — Windows agent",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@xhayper/discord-rpc": "^1.2.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "pkg": "^5.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "targets": ["node20-win-x64"],
    "outputPath": "release"
  }
}
